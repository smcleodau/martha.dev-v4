{
  "name": "martha-dev",
  "version": "3.0.0",
  "description": "Martha.dev MAPDS - Multi-Agent Parallel Development System",
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "swc src -d dist --copy-files && ./scripts/fix-esm-imports.sh",
    "start": "node dist/src/index.js",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules\" jest",
    "test:unit": "NODE_OPTIONS=\"--experimental-vm-modules\" jest tests/unit",
    "test:integration": "NODE_OPTIONS=\"--experimental-vm-modules\" jest tests/integration",
    "test:e2e": "NODE_OPTIONS=\"--experimental-vm-modules\" jest tests/e2e",
    "test:watch": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --watch",
    "test:coverage": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "db:setup": "tsx scripts/setup-database.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed-dev-data.ts",
    "validate": "tsx scripts/validate-phase1.ts",
    "tracker:migrate": "tsx scripts/migrate-to-multi-board.ts",
    "tracker:migrate:dry-run": "tsx scripts/migrate-to-multi-board.ts --dry-run",
    "agent": "tsx src/agents/index.ts",
    "agent:build": "swc src/agents -d dist/agents --copy-files",
    "agent:start": "node dist/agents/index.js",
    "mcp": "tsx src/mcp/server.ts",
    "mcp:build": "swc src/mcp -d dist/mcp --copy-files",
    "mcp:start": "node dist/mcp/server.js",
    "worker": "tsx src/temporal/worker.ts",
    "worker:build": "swc src/temporal -d dist/temporal --copy-files && swc src/workflows -d dist/workflows --copy-files && swc src/activities -d dist/activities --copy-files",
    "worker:start": "node dist/temporal/worker.js",
    "temporal:client": "tsx -e 'import { getTemporalClient } from \"./src/temporal/client.js\"; getTemporalClient().then(() => console.log(\"Connected!\"))'",
    "verify:all": "tsx scripts/autonomous-verify/run-all.ts",
    "verify:infra": "tsx scripts/autonomous-verify/phase1-infrastructure.ts",
    "verify:unit": "tsx scripts/autonomous-verify/phase2-unit-tests.ts",
    "verify:integration": "tsx scripts/autonomous-verify/phase3-integration.ts",
    "verify:load": "tsx scripts/autonomous-verify/phase5-load-testing.ts",
    "verify:errors": "tsx scripts/autonomous-verify/phase6-error-scenarios.ts",
    "verify:observability": "tsx scripts/autonomous-verify/phase7-observability.ts",
    "verify:report": "tsx scripts/autonomous-verify/phase8-reporting.ts",
    "prepare": "husky install || true"
  },
  "keywords": [
    "mcp",
    "claude",
    "claude-flow",
    "worktree",
    "orchestration",
    "multi-agent"
  ],
  "author": "Martha.dev",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^6.12.0",
    "@fastify/websocket": "^10.0.1",
    "@modelcontextprotocol/sdk": "^0.5.0",
    "@octokit/graphql": "^7.0.2",
    "@octokit/rest": "^20.0.2",
    "@temporalio/activity": "^1.14.1",
    "@temporalio/client": "^1.14.1",
    "@temporalio/worker": "^1.14.1",
    "@temporalio/workflow": "^1.14.1",
    "@types/cors": "^2.8.19",
    "axios": "^1.6.5",
    "chokidar": "^3.6.0",
    "cors": "^2.8.5",
    "dockerode": "^4.0.2",
    "dotenv": "^16.4.1",
    "express": "^5.2.1",
    "fastify": "^4.26.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.3.2",
    "pg": "^8.11.3",
    "pidusage": "^4.0.1",
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.1",
    "prom-client": "^15.1.3",
    "uuid": "^13.0.0",
    "ws": "^8.16.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@swc/cli": "^0.3.9",
    "@swc/core": "^1.4.2",
    "@temporalio/testing": "^1.14.1",
    "@types/dockerode": "^3.3.24",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.16",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "husky": "^9.0.10",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
