# Python Service Integration (for gradual migration)
PYTHON_SERVICE_URL=http://localhost:20000

# GitHub Integration
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# Cloudflare Integration
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DOMAIN=arch.ie

# MCP Configuration
MCP_SERVER_NAME=martha-dev
MCP_SERVER_VERSION=3.0.0

# Braintrust (LLM Observability)
BRAINTRUST_API_KEY=

# Browserbase (E2E Session Replay)
