# Test environment variables
NODE_ENV=test
LOG_LEVEL=error

# Worktree
WORKTREE_INDEX=1
WORKTREE_NAME=test

# Ports
SERVICE_PORT=3000
REDIS_PORT=6379
MCP_PORT=3001
METRICS_PORT=9090
DASHBOARD_PORT=3002

# Database
DATABASE_URL=postgresql://test:test@localhost:5432/test_db
DATABASE_SCHEMA=martha

# Redis
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=ts:

# Temporal Cloud (dummy values for tests)
TEMPORAL_ADDRESS=test.temporal.io:7233
TEMPORAL_NAMESPACE=test
TEMPORAL_TASK_QUEUE=test-queue
TEMPORAL_API_KEY=test-key

# Optional services
PYTHON_SERVICE_URL=http://localhost:8000

# GitHub (optional)
GITHUB_TOKEN=
GITHUB_REPO=

# Cloudflare (optional)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DOMAIN=arch.ie

# MCP
MCP_SERVER_NAME=martha-dev-test
MCP_SERVER_VERSION=3.0.0

# Braintrust (optional)
BRAINTRUST_API_KEY=

# Browserbase (optional)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Logging
LOG_PRETTY=false

# Metrics
METRICS_DIR=~/.martha/metrics

# Tracker
MARTHA_DIR=/mnt/data/martha-workflow/.martha
TRACKER_SYNC_ENABLED=false
GITHUB_OWNER=

