# Service Configuration
WORKTREE_INDEX=21
WORKTREE_NAME=typescript-rewrite
NODE_ENV=development

# Port Allocation (Index 21 during testing)
SERVICE_PORT=21000
REDIS_PORT=21001
MCP_PORT=21002
METRICS_PORT=21003
DASHBOARD_PORT=21004

# Database (Separate instance during testing to avoid shared failure domain)
DATABASE_URL=postgresql://archie_user:password@localhost:21005/martha_ts
DATABASE_SCHEMA=ts_martha

# Redis (Shared with Python, different prefix)
REDIS_URL=redis://:password@localhost:20001
REDIS_KEY_PREFIX=ts:

# Python Service Integration (for gradual migration)
PYTHON_SERVICE_URL=http://localhost:20000

# GitHub Integration
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# Cloudflare Integration
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DOMAIN=arch.ie

# MCP Configuration
MCP_SERVER_NAME=martha-dev
MCP_SERVER_VERSION=3.0.0

# Braintrust (LLM Observability)
BRAINTRUST_API_KEY=

# Browserbase (E2E Session Replay)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# Metrics
METRICS_DIR=~/.martha/metrics

# Tracker Configuration
MARTHA_DIR=/mnt/data/martha-workflow/.martha
TRACKER_SYNC_ENABLED=true
GITHUB_OWNER=your-org
GITHUB_REPO=your-repo

# Temporal Configuration
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=martha-tasks
TEMPORAL_MAX_CONCURRENT_WORKFLOWS=100
TEMPORAL_MAX_CONCURRENT_ACTIVITIES=100
TEMPORAL_WORKFLOW_TIMEOUT=86400000
TEMPORAL_ACTIVITY_TIMEOUT=1800000
TEMPORAL_MAX_RETRY_ATTEMPTS=5
TEMPORAL_INITIAL_RETRY_INTERVAL=5000
TEMPORAL_BACKOFF_COEFFICIENT=2.0
TEMPORAL_MAX_RETRY_INTERVAL=300000

# TimescaleDB Configuration
TIMESCALEDB_ENABLED=true

# Alerting Configuration
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
