# ============================================================================
# Main Develop Branch (Production/Staging Environment)
# Index: 1 (Highest Priority)
# Port Range: 1000-1004
# ============================================================================
# MANAGED BY: Worktree Monitoring System
# DO NOT COMMIT THIS FILE
# ============================================================================
# This is the MAIN develop branch serving stuart.arch.ie
# Worktrees use 3000+ ranges to avoid conflicts
# ============================================================================

WORKTREE_INDEX=1
WORKTREE_NAME=main-develop
COMPOSE_PROJECT_NAME=archie-main-dev

# ============================================================================
# Port Configuration (1xxx range - PRODUCTION)
# ============================================================================
POSTGRES_PORT=1000
REDIS_PORT=1001
API_PORT=1002
PGADMIN_PORT=1003
FRONTEND_PORT=1004

# ============================================================================
# Database Configuration
# ============================================================================
POSTGRES_DB=archie_dev
DATABASE_URL=postgresql://archie_user:archie_dev_password@localhost:1000/archie_dev
DATABASE_URL_INTERNAL=postgresql://archie_user:archie_dev_password@postgres:5432/archie_dev

# Database URL variants for compatibility
POSTGRES_URL=postgresql://archie_user:archie_dev_password@localhost:1000/archie_dev

# ============================================================================
# Redis Configuration
# ============================================================================
REDIS_URL=redis://:archie_dev_redis_password@localhost:1001
REDIS_URL_INTERNAL=redis://:archie_dev_redis_password@redis:6379

# ============================================================================
# API Configuration
# ============================================================================
API_URL=http://localhost:1002
FRONTEND_URL=http://localhost:1004

# ============================================================================
# Stuart.arch.ie Production Environment
# ============================================================================
# External URL served via Cloudflare
EXTERNAL_API_URL=https://stuart.arch.ie
EXTERNAL_WS_URL=wss://stuart.arch.ie/ws

# ============================================================================
# WARNING: Port Isolation
# ============================================================================
# Main branch uses: 1000-1004
